+def _agy_bin() -> str:
+    import shutil
+    agy = os.environ.get("AGY_BIN") or shutil.which("agy") or shutil.which("agy.exe")
+    if not agy:
+        cand = os.path.expanduser("~/AppData/Local/agy/bin/agy.exe")
+        if os.path.isfile(cand):
+            agy = cand
+    if not agy:
+        raise RuntimeError(
+            "Antigravity CLI (`agy`) not found on $PATH. Install from https://antigravity.google, "
+            "run `agy` once to sign in, or set AGY_BIN to its path."
+        )
+    return agy
+
+
+def _call_agy_cli(user_message: str, max_tokens: int = 8192, *, deep_mode: bool = False, images: list["_ImageRef"] | None = None) -> dict:
+    """Call Gemini via the locally-installed Google Antigravity CLI (`agy --print`).
+
+    Routes through the user's Antigravity / Google sign-in instead of a GEMINI_API_KEY,
+    so graphify's semantic pass is built by Gemini and runs OFF the host coding
+    assistant's token budget (billed to the user's Gemini plan). Mirrors `_call_claude_cli`.
+
+    agy quirks handled (see github.com/MarcosNahuel/antigravity-plugin-cc):
+      - `agy --print` writes nothing to stdout outside a TTY (upstream issue #76): we
+        instruct agy to write the JSON to a file and read it back from disk.
+      - agy requires the prompt as an argv (it does NOT read it from stdin), and big
+        chunks blow the OS command-line length limit — so the full prompt is written to
+        a file that agy reads; the `--print` arg is just a short directive.
+      - agy must run from a NEUTRAL cwd (not a git project) or it sandboxes write_file
+        artifacts and rejects the output path; we cd to a fresh temp dir and --add-dir it.
+      - `--print` must be the last flag; stdin is closed so agy doesn't block.
+    """
+    import subprocess
+    import tempfile
+
+    agy = _agy_bin()
+    work = tempfile.mkdtemp(prefix="graphify-agy-")     # neutral cwd, not a git project
+    out_file = os.path.join(work, "out.json")
+    prompt_file = os.path.join(work, "prompt.txt")
+
+    add_dir_args = ["--add-dir", work]
+    if images:
+        user_message = _with_image_notes(user_message, images, with_paths=True)
+        seen = {work}
+        for r in images:
+            d = str(r.path.parent)
+            if d not in seen:
+                seen.add(d)
+                add_dir_args += ["--add-dir", d]
+
+    full_prompt = (
+        _extraction_system(deep=deep_mode) + "\n\n" + user_message
+        + "\n\nOUTPUT REQUIREMENT (CRITICAL): your answer is a single raw JSON object — no prose, "
+          "no markdown fences. Write that JSON, and nothing else, to this absolute path with your "
+          f"write_file tool: {out_file}"
+    )
+    with open(prompt_file, "w", encoding="utf-8") as fh:
+        fh.write(full_prompt)
+
+    directive = (
+        f"Read the task in the file {prompt_file} and do exactly what it says. Write ONLY the "
+        f"resulting JSON object to {out_file} using your write_file tool. Do not print to chat; "
+        "the written file is your only deliverable."
+    )
+    timeout = _resolve_api_timeout()
+    cli_args = [
+        agy, "--dangerously-skip-permissions", *add_dir_args,
+        "--print-timeout", f"{int(timeout)}s", "--print", directive,
+    ]
+    proc = subprocess.run(
+        cli_args, input="", capture_output=True, text=True, encoding="utf-8",
+        cwd=work, timeout=timeout + 30, check=False, **_no_window_kwargs(),
+    )
+
+    # agy auth-noise + the empty-stdout bug (#76) make returncode/stdout unreliable; trust the file.
+    raw_content = ""
+    if os.path.isfile(out_file):
+        try:
+            raw_content = open(out_file, encoding="utf-8", errors="ignore").read().strip()
+        except Exception:
+            raw_content = ""
+    if not raw_content:
+        raw_content = (proc.stdout or "").strip()
+    if not raw_content:
+        raise RuntimeError(
+            f"agy produced no output ({out_file} missing/empty). returncode={proc.returncode}; "
+            f"stderr: {(proc.stderr or '').strip()[:300]}"
+        )
+
+    result = _parse_llm_json(raw_content)
+
+    def _est(s: str) -> int:
+        try:
+            return len(_TOKENIZER.encode(s)) if _TOKENIZER else max(1, len(s) // 4)
+        except Exception:
+            return max(1, len(s) // 4)
+    result["input_tokens"] = _est(full_prompt)
+    result["output_tokens"] = _est(raw_content)
+    result["model"] = "gemini-via-agy"
+    result["finish_reason"] = "length" if _response_is_hollow(raw_content, result) else "stop"
+
+    import shutil as _sh
+    _sh.rmtree(work, ignore_errors=True)
+    return result
+
