    "anthropic",
    "subagent",
    "task-delegation",
    "html-report",
    "infographic",
    "markdown-to-html",
    "design-system",
    "web-scraping",
    "pdf-to-markdown",
    "design-review",
    "code-review",
    "browser-recording",
    "gemini-cli-replacement",
    "gemini-cli-migration"
  ],
  "bin": {
    "antigravity-plugin-cc": "bin/cli.js"
  },
